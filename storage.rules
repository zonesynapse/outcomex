rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /coe_signatures/{allPaths=**} {
      allow read, write: if true;
    }
    match /signatures/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
