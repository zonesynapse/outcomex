rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isMasterAdmin() {
      return isAuthenticated() && request.auth.token.email == 'cselab2022@gmail.com';
    }

    function isApproved() {
      return isAuthenticated() && (
        isMasterAdmin() || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isApproved == true
      );
    }

    function hasPagePermission(pageId) {
      let userRole = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
      return get(/databases/$(database)/documents/role_permissions/$(userRole)).data[pageId] == true;
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == userId || isMasterAdmin());
    }

    match /role_permissions/{role} {
      allow read: if isAuthenticated();
      allow write: if isApproved() && (isMasterAdmin() || hasPagePermission('admin-roles'));
    }

    match /seatConfigurations/{dept} {
      allow read: if isApproved();
      allow write: if isApproved();
    }

    match /enquiries/{enquiryId} {
      allow read: if isApproved();
      allow write: if isApproved();
    }

    match /fee_configurations/{configId} {
      allow read: if isApproved();
      allow write: if isApproved();
    }
    
    match /programme_departments/{programme} {
      allow read: if true;
      allow write: if isApproved() && isMasterAdmin();
    }

    match /programme_durations/{programme} {
      allow read: if true;
      allow write: if isApproved() && isMasterAdmin();
    }

    match /settings_communities/{comm} {
      allow read: if isAuthenticated();
      allow write: if isApproved();
    }

    match /courses/{courseId} {
      allow read: if isApproved();
      allow write: if isApproved();
    }

    match /course_type_configs/{configId} {
      allow read: if isApproved();
      allow write: if isApproved();
    }

    match /period_configs/{configId} {
      allow read: if isApproved();
      allow write: if isApproved();
    }

    match /blooms_taxonomy/{domainId} {
      allow read: if isApproved();
      allow write: if isApproved();
    }

    match /students/{studentDocId} {
      allow read: if isAuthenticated();
      allow write: if isApproved();
    }

    match /batch_status/{batchId} {
      allow read: if true;
      allow write: if isApproved();
    }

    match /syllabus_data/{syllabusId} {
      allow read: if isApproved();
      allow write: if isApproved();
    }

    match /scholarships/{scholarshipId} {
      allow read: if isApproved();
      allow write: if isApproved();
    }

    // Library module — disabled until verified
    match /books/{docId} { allow read, write: if false; }
    match /book_categories/{docId} { allow read, write: if false; }
    match /book_issues/{docId} { allow read, write: if false; }
    match /library_entry_logs/{docId} { allow read, write: if false; }

    // Placement module — disabled until verified
    match /placement_companies/{docId} { allow read, write: if false; }
    match /placement_drives/{docId} { allow read, write: if false; }
    match /placement_students/{docId} { allow read, write: if false; }
    match /placement_applications/{docId} { allow read, write: if false; }
    match /placement_interview_rounds/{docId} { allow read, write: if false; }
    match /placement_offers/{docId} { allow read, write: if false; }
    match /placement_training_sessions/{docId} { allow read, write: if false; }

    // Fee Categories — enabled (used as master list of fee heads)
    match /fee_categories/{docId} {
      allow read: if isApproved();
      allow write: if isApproved();
    }

    // Fee Payments — students read own records; write only via Cloud Function (Admin SDK)
    match /fee_payments/{docId} {
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isApproved());
      allow write: if false;
      allow create: if false;
      allow delete: if false;
    }
    match /fee_receipts/{docId} { allow read, write: if false; }
    match /fee_concessions/{docId} { allow read, write: if false; }
    match /fee_heads/{docId} { allow read, write: if false; }
    match /fee_defaulters_cache/{docId} { allow read, write: if false; }

    match /student_index/{docId} {
      allow read: if true;
      allow write: if isApproved();
    }

    match /step_activities/{activityId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /step_config/{configId} {
      allow read: if isAuthenticated();
      allow write: if isApproved() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Principal' ||
        isMasterAdmin()
      );
    }

    match /{document=**} {
      allow read: if isApproved();
      allow write: if isApproved();
    }
  }
}